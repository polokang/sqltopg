# sqltopg 配置示例
#
# 本地：复制成 .env，dotenv 会自动读取。
# 服务器：放到 ~/sqltopg/.env，由 docker-compose.yml 挂到容器的 /app/.env。
#
# ⚠️ 服务器上的两条硬性要求（否则会出现很难查的故障）：
#     1. **LF 行尾、值不要加引号。** 本地 .env 带引号也能跑（dotenv 会剥），
#        但别的注入方式不会剥，留着迟早出事。
#     2. **chmod 644**（父目录 chmod 700）。镜像以非 root 的 uid 1001 运行，
#        600 的文件容器读不到。
#
# ⚠️ 不要把这些变量写进 docker-compose.yml 的 environment: —— dotenv 不覆盖
#    已存在的环境变量，写在那里会让 .env 里的同名值被静默忽略。

# ─── 数据库连接 ───────────────────────────────────────────────────────────────

# 源库。⚠️ `database=` 决定实际读哪个库 —— 查询用的是三段式表名
# `<database>.dbo.<table>`，库名从这里取，不是硬编码的。
SQL_SERVER_URL=sqlserver://aquareporter.com.au:1433;database=AquariusEmailDB;user=<用户>;password=<口令>;trustServerCertificate=true

# 目标库
POSTGRESQL_URL=postgresql://<用户>:<口令>@aquariuspgdb.postgres.database.azure.com:5432/AquariusPG


# ─── 同步调度 ─────────────────────────────────────────────────────────────────

# 同步频率（分钟）。两种模式二选一：
#
#   0（或留空）  → **每天定时**一次，时刻由下面的 SYNC_AT_HOUR + SYNC_TIMEZONE 决定
#   >0           → **按间隔**跑，每 N 分钟一次；此时 SYNC_AT_HOUR / SYNC_TIMEZONE
#                  不再参与调度
#
# 方案 A 定为 2 分钟（2026-10-14）。间隔模式下限 1 分钟，填更小的值会被提升并告警。
#    单轮实测约 2 秒（2026-09-09，本机 → Azure PG）。调密后看 sync_runs.duration_ms。
#
# ⚠️ 这个值同时决定**双写的自愈窗口**：mirror 写失败后，最长要等一个周期才会被
#    同步纠正。每天一次 = 最长 24 小时；每 2 分钟 = 最长约 2 分钟。
#
# ⚠️ 前提：生产 PG 已有 users / controllers 的 sync_source 列（migrations/005），
#    否则高频同步会撞上孤儿清理的竞态（见 src/sync-simple.js 不变式 I2）。
SYNC_INTERVAL_MINUTES=2

# 以下两个**仅在 SYNC_INTERVAL_MINUTES=0 时生效**
SYNC_AT_HOUR=0                      # 每天几点跑，0 = 午夜
SYNC_TIMEZONE=Australia/Brisbane    # IANA 时区名。昆士兰全年 UTC+10，无夏令时

# 服务启动时是否立刻补跑一次。默认 true —— 部署完立刻就能知道通不通，
# 不用等到下一个周期。容器频繁重启的场景可以设成 false。
SYNC_ON_STARTUP=true

# sync_runs（同步运行日志）保留天数。启动时和每轮同步后删掉更早的已结束记录。
# 每 2 分钟一行 ≈ 每天 720 行。0 = 不清理。
SYNC_RUNS_RETENTION_DAYS=90


# ─── 其它 ─────────────────────────────────────────────────────────────────────

# 健康检查端口。容器部署时由 docker-compose.yml 钉成 3000（要与端口映射一致），
# 本地跑可以随意改。
PORT=3000
